  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.03"/>
      <geometry>
        <mesh filename="package://nori_description/meshes/visual/RPLiDarC1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="nori_sensor"/>
    </visual>
    <collision>
      <!-- Use a simple cylindrical envelope for the detailed C1 assembly. -->
      <origin rpy="0 0 0" xyz="0 0 -0.009349999999999997"/>
      <geometry>
        <cylinder length="0.0413" radius="0.0278"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.009349999999999997"/>
      <mass value="0.11"/>
      <inertia ixx="3.6888591666666666e-05" ixy="0.0" ixz="0.0" iyy="3.6888591666666666e-05" iyz="0.0" izz="4.2506199999999996e-05"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.00422459 0.0 0.12962764"/>
  </joint>
  <!--
      The installed C1 scan axes are rotated 180 degrees from Nori's
      forward/left convention. Keep lidar_link aligned with the physical model
      and expose a corrected frame for LaserScan data.
    -->
  <link name="lidar_scan_link"/>
  <joint name="lidar_scan_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="lidar_scan_link"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <!--
      imu_link follows the BNO085's physical axes. The installed board's +X
      points toward robot +X and +Y points toward robot +Y (left), so the IMU
      frame is aligned with the robot frame.
    -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.00525 0.00385 0.0012"/>
      </geometry>
      <material name="nori_sensor"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.00525 0.00385 0.0012"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.3552083333333335e-08" ixy="0.0" ixz="0.0" iyy="2.4168750000000003e-08" iyz="0.0" izz="3.532083333333334e-08"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.01843359 -0.08090774 0.05782764000000001"/>
  </joint>
  <link name="torso_shell_link">
    <!-- Body and lower cap are the arms' dark plastic; the upper cap is white, so
           the torso reads as a pale shoulder line over a dark body. -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.12 0.25 0.1"/>
      </geometry>
      <material name="nori_arm_plastic"/>
    </visual>
    <!-- A URDF cylinder runs along its own Z, so rpy rolls it 90 deg about X to
           lay it sideways across the robot's Y. -->
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0.05"/>
      <geometry>
        <!-- Slightly shorter than torso_y so the white cap's ends stop just
               inside the body's side faces. The lower cap keeps the full width:
               it shares the box's material, so its coincident ends have no colour
               difference to flicker between. -->
        <cylinder length="0.242" radius="0.061"/>
      </geometry>
      <material name="nori_white"/>
    </visual>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.05"/>
      <geometry>
        <cylinder length="0.242" radius="0.061"/>
      </geometry>
      <material name="nori_arm_plastic"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.009062500000000001" ixy="0.0" ixz="0.0" iyy="0.00305" iyz="0.0" izz="0.0096125"/>
    </inertial>
  </link>
  <joint name="torso_shell_joint" type="fixed">
    <parent link="lift_top_link"/>
    <child link="torso_shell_link"/>
    <!-- Top cap centre lands on the shoulder axis. -->
    <origin rpy="0 0 0" xyz="0 0 0.03698265999999999"/>
  </joint>
  <link name="neck_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.1 0.08"/>
      </geometry>
      <material name="nori_arm_plastic"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002733333333333334" ixy="0.0" ixz="0.0" iyy="0.00021333333333333336" iyz="0.0" izz="0.0002733333333333334"/>
    </inertial>
  </link>
  <joint name="neck_joint" type="fixed">
    <parent link="torso_shell_link"/>
    <child link="neck_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.09"/>
  </joint>
  <link name="head_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.1 0.176 0.117"/>
      </geometry>
      <material name="nori_white"/>
    </visual>
    <!-- Screen: a panel standing proud of the head's front face, sharing the
           head's frame so it stays square to the face as the head tilts. -->
    <visual>
      <origin rpy="0 0 0" xyz="0.05 0 0.01053"/>
      <geometry>
        <box size="0.008 0.14256 0.08073"/>
      </geometry>
      <material name="nori_screen"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.052500000000000005 0.0313632 0.01053"/>
      <geometry>
        <box size="0.006 0.0199584 0.0444015"/>
      </geometry>
      <material name="nori_eye"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.052500000000000005 -0.0313632 0.01053"/>
      <geometry>
        <box size="0.006 0.0199584 0.0444015"/>
      </geometry>
      <material name="nori_eye"/>
    </visual>
    <!-- Cap, pitched up off the head's own (already tilted) frame. -->
    <visual>
      <origin rpy="0 -0.6108652381980153 0" xyz="0.03 0 0.0585"/>
      <geometry>
        <box size="0.13 0.176 0.016"/>
      </geometry>
      <material name="nori_white"/>
    </visual>
    <visual>
      <origin rpy="0 -0.6108652381980153 0" xyz="0.03819152044288992                0                0.06423576436351046"/>
      <geometry>
        <box size="0.13 0.146 0.022"/>
      </geometry>
      <material name="nori_arm_plastic"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.72"/>
      <inertia ixx="0.0026798999999999994" ixy="0.0" ixz="0.0" iyy="0.00142134" iyz="0.0" izz="0.00245856"/>
    </inertial>
  </link>
  <joint name="head_joint" type="fixed">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <origin rpy="0 -0.08726646259971647 0" xyz="0 0 0.0985"/>
  </joint>
</robot>
