<robot name="nori">
  <!--
    Materials, named by what the part is actually made of rather than by colour,
    so a finish change is a one-line edit here instead of a rename everywhere.

    URDF materials carry colour only - no roughness or metalness - so these are
    base colours and every renderer applies its own shading model on top. Values
    are approximate finishes, not measured colours.
  -->
  <!-- Arm links and grippers: dark grey moulded plastic. -->
  <material name="nori_arm_plastic">
    <color rgba="0.16 0.17 0.18 1.0"/>
  </material>
  <!-- Chassis: darker than the arms, slightly warmer. -->
  <material name="nori_chassis">
    <color rgba="0.11 0.12 0.13 1.0"/>
  </material>
  <!-- Lift sections: bare metal.
       NOTE materials.yaml still assigns these links to body_mat ("foam-covered,
       near-fully matte"), which is out of date. Until that is corrected the viewer
       carries a temporary finish override; see FINISH_OVERRIDES in
       nori/components/RobotUrdfViewer.tsx. -->
  <material name="nori_lift_metal">
    <color rgba="0.34 0.35 0.37 1.0"/>
  </material>
  <!-- Tyres and caster treads: near-black rubber. -->
  <material name="nori_tyre">
    <color rgba="0.07 0.07 0.08 1.0"/>
  </material>
  <!-- Sensor housings. -->
  <material name="nori_sensor">
    <color rgba="0.18 0.19 0.21 1.0"/>
  </material>
  <!-- Display glass: darker and cooler than the body plastic. -->
  <material name="nori_screen">
    <color rgba="0.05 0.06 0.08 1.0"/>
  </material>
  <!-- Eyes: brighter than the body white so they read as lit against the screen. -->
  <material name="nori_eye">
    <color rgba="0.99 0.99 0.99 1.0"/>
  </material>
  <!-- Near-white: head and the torso's upper cap. -->
  <material name="nori_white">
    <color rgba="0.93 0.94 0.95 1.0"/>
  </material>
  <!-- Light shell panels. -->
  <material name="nori_shell">
    <color rgba="0.80 0.81 0.83 1.0"/>
  </material>
  <!--
    8-DOF arm mounted to the moving top of the central lift. Joint names map
    to servo bus IDs 1-8 in ../ros2_control/nori_feetech.ros2_control.xacro
    and must stay in sync with it. Links are named after the joint that moves
    them.

    Zero pose: each arm downstream of shoulder_roll extends laterally outward,
    90 degrees from the former hanging pose; the arm-mount and shoulder_pitch
    frames stay unchanged. Pitch joints rotate about Y, roll about X, and yaw
    about Z.
    The wrist stages follow that motion-based convention: wrist_pitch (bus ID 6)
    is the Y-axis stage and wrist_roll (bus ID 7) is the downstream X-axis
    stage. Each joint origin lies on its rotation axis, and consecutive origins
    differ by the local *_drop Z distances in properties.xacro; shoulder_roll
    additionally carries a mirrored Y offset relative to the shoulder-pitch
    axis.

    Visuals are per-link STLs (millimetres, exported lying along -Y, origin
    at the part's lower/child servo axis — except shoulder_pitch, whose
    origin is its own axis). Both arms reuse one STL set; after each arm's
    180-degree rotation about the central column, the left arm uses a negative
    mesh Z scale. That can shade oddly in some renderers; export mirrored
    copies if it matters. The measured housing envelopes serve as collision
    and inertial geometry. The gripper is a geared two-finger claw: one
    servo-driven finger plus an idler finger on a mimic joint.

    Both arms' positive rotation signs are physically commissioned in
    nori-calibrate-feetech-arm and persisted in their calibration files.
    Recheck them after mechanical changes; keep URDF axes geometric and correct
    mounting polarity through the hardware positive_direction parameters.
  -->
  <!-- Per-side inset for the WHITE upper cap along Y.
       torso_cap_proud already lifts the caps off the front and back faces, so the
       only surfaces still sharing a plane with the body are the cylinders' flat
       ENDS against the box's +/-Y faces. At length == torso_y those are exactly
       coincident, the depth buffer cannot order them, and the seam flickers as the
       camera moves - worst on the upper cap, where near-white meets dark plastic.
       1 mm off a 250 mm span is invisible at any viewing distance and unambiguous
       to the depth test.

       Written as torso_y minus this rather than a literal, so changing
       arm_mount_separation cannot silently restore the coplanar case. -->
  <!-- Head tilts nose-UP. Positive pitch about +Y drops the nose in this frame
       (X forward, Z up), so an upward tilt is negative. head_pitch_deg lives in
       properties.xacro: the overhead camera's aim depends on it too. -->
  <!--
    positive_direction is motion viewed from each servo's output shaft.
    Rotary-arm centers, directions, and raw bounds are loaded from the manual
    calibration file when the complete two-arm macro is selected. An absent or
    incomplete joint entry keeps that joint torque-disabled.
  -->
  <!-- base_footprint lies on the nominal ground plane; +X forward, +Y left, +Z up. -->
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="-0.13327540999999998 0 0.02962764"/>
      <geometry>
        <box size="0.35 0.2 0.04"/>
      </geometry>
      <material name="nori_chassis"/>
    </visual>
    <!-- Plastic outer shell. A SECOND visual on the same link: URDF allows any
           number, so the metal frame above and this shell both render without
           needing an extra link or joint, and the link's mass still covers both.
           See properties.xacro for why the offsets are what they are. -->
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0.691944 0.216671 0.667639"/>
      <geometry>
        <mesh filename="package://nori_description/meshes/visual/base_shell.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="nori_shell"/>
